# Copy to .env (git-ignored) and fill in.
# Local: `supabase status` prints the API URL and the service_role key.
# Cloud: put the cloud URL and service_role key in .env.cloud (also git-ignored)
# and run `pnpm import:places:cloud <csv>...`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
