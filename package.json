{
  "name": "lunch-roulette",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter @lunch/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @lunch/web test:e2e",
    "import:places": "pnpm --filter @lunch/import-places run import:places",
    "import:places:cloud": "pnpm --filter @lunch/import-places run import:places:cloud",
    "functions:sync-core": "node scripts/sync-functions-core.mjs",
    "functions:serve": "pnpm functions:sync-core && supabase functions serve",
    "functions:deploy": "pnpm functions:sync-core && supabase functions deploy create-room"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
